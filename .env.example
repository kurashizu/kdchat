# Copy to .env (same directory as app.py) and edit. .env is git-ignored; keep it chmod 600.

# Required: the password for the web console and the API (HTTP Basic, any user name)
AUTH_PASSWORD=change-me

# Where VRChat runs (its OSC input port, UDP)
VRC_HOST=127.0.0.1
VRC_PORT=9000

# Only for `uv run python app.py` (the systemd unit uses it too)
LISTEN_HOST=0.0.0.0
LISTEN_PORT=5555

# Optional
# KD_OSC_HOST=127.0.0.1     # Klaude display target, defaults to VRC_HOST
# KD_DRY=1                  # Klaude display: encode only, send nothing
# STATE_FILE=/path/state.json
# LOG_LEVEL=INFO

# Copy to .env (next to app.py; for the Windows app: %APPDATA%\kdchat\.env) and edit.
# .env is git-ignored; keep it private (chmod 600). Every value here is optional.
# Settings changed in the web console (settings.json) take precedence over this file.

# Password for the web console and the API (HTTP Basic, any user name). Empty / unset = no login.
# A server reachable by others should have one.
AUTH_PASSWORD=change-me

# Where VRChat runs (its OSC input, UDP). Default 127.0.0.1:9000 = VRChat on the same machine.
VRC_HOST=127.0.0.1
VRC_PORT=9000

# Web server address. Default 0.0.0.0:5555 (all networks, so phones on the LAN can connect).
LISTEN_HOST=0.0.0.0
LISTEN_PORT=5555

# Optional
# ALLOWED_ORIGINS=https://my-site.example   # other web pages that may call the API (comma-separated)
# KDCHAT_DATA_DIR=/path/to/data                # where settings.json / state.json live (default: next to app.py)
# SETTINGS_FILE=/path/settings.json
# STATE_FILE=/path/state.json
# KD_DRY=1                                  # Klaude display: encode only, send nothing (testing)
# LOG_LEVEL=INFO

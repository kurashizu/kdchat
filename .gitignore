# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv

# local config and run-time data (never commit)
.env
state.json
*.log

# deploy leftovers
backup-*.tgz
*.bak
*.bak-*
._*
.DS_Store

# settings saved by the console (may hold a password hash)
settings.json
settings.json.bad
*.tmp
preview.png

# the console's sources (web/): dependencies and SvelteKit's generated files (the build itself, ui/, is committed)
web/node_modules/
web/.svelte-kit/
